# FocusEd AI — environment variables
# Copy to .env and fill in. NEVER commit a filled-in .env.
# All values below are EMPTY placeholders — no real keys are included.

# --- Supabase (required for real mode; without these the app runs in Demo Mode) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers (server-side only; used by the ai-tutor Edge Function) ---
# Set only the provider(s) your institution uses. Never expose these to the client.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Cron worker ---
# Shared secret the scheduler sends as x-cron-secret to notification-worker.
CRON_SECRET=

# --- Optional: email provider for guardian invitations (not wired up yet) ---
# RESEND_API_KEY=
